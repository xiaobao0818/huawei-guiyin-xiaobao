{
  "dashboard": {
    "title": "鲸鸿动能归因平台",
    "panels": [
      {
        "title": "归因漏斗",
        "type": "bargauge",
        "targets": [
          { "expr": "rate(attribution_funnel_total[5m])", "legendFormat": "{{stage}}" }
        ]
      },
      {
        "title": "回传成功率",
        "type": "stat",
        "targets": [
          { "expr": "rate(attribution_callback_total{result=\"success\"}[15m]) / rate(attribution_callback_total[15m]) * 100" }
        ],
        "fieldConfig": { "defaults": { "unit": "percent" } }
      },
      {
        "title": "回传延迟 (P50/P95/P99)",
        "type": "timeseries",
        "targets": [
          { "expr": "histogram_quantile(0.50, rate(attribution_callback_latency_bucket[5m]))", "legendFormat": "P50" },
          { "expr": "histogram_quantile(0.95, rate(attribution_callback_latency_bucket[5m]))", "legendFormat": "P95" }
        ]
      },
      {
        "title": "事件分布 (按游戏)",
        "type": "timeseries",
        "targets": [
          { "expr": "rate(attribution_events_total[5m])", "legendFormat": "{{game}}/{{event}}" }
        ]
      },
      {
        "title": "匹配结果分布",
        "type": "piechart",
        "targets": [
          { "expr": "rate(attribution_match_total[15m])", "legendFormat": "{{type}}" }
        ]
      }
    ]
  }
}
