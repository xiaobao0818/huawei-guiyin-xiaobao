# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_PASSWORD=replace-with-strong-app-password

# 鲸鸿动能回调地址
CALLBACK_URL=https://ppscrowd-drcn.op.hicloud.com/action-lib-track/hiad/v2/actionupload

# AES 加密密钥 (必须恰好32个字符/字节，建议使用随机生成的十六进制字符串)
# 生成方式: openssl rand -hex 16
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 客户端上报 API Key
ATTRIBUTION_API_KEY=replace-with-report-api-key

# 管理后台账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
